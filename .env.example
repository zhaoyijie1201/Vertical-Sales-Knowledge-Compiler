# Copy to .env and fill in. The .env file is not committed.

# API key: set it here, or leave it empty and point VSKC_KEY_FILE at a text file
# that contains only the key. The default key file is ../openrouter_api.txt.
OPENROUTER_API_KEY=
VSKC_KEY_FILE=

# Model slugs, copied from the provider's model list.
# List them with: python scripts/check_setup.py --models anthropic
# The two generation models must differ from the model under test.
VSKC_MODEL_UNDER_TEST=
VSKC_MODEL_GEN_DEV=
VSKC_MODEL_GEN_HELDOUT=

VSKC_BASE_URL=https://openrouter.ai/api/v1
VSKC_TOP_K=5
VSKC_MAX_TOKENS=4000
# json_schema | json_object | none
VSKC_RESPONSE_FORMAT=json_schema

# Price of the model under test per million tokens, and the date you looked it up.
VSKC_PRICE_IN_PER_MTOK=
VSKC_PRICE_OUT_PER_MTOK=
VSKC_PRICE_CHECKED_ON=

# Set to 1 to run without calling any model (deterministic fake replies).
VSKC_MOCK=
